// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String
  firstName        String?
  lastName         String?
  phoneNumber      String?   @unique
  profileImageUrl  String?
  language         String?   @default("en")
  currency         String?   @default("USD")
  role             Role      @default(USER)
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  refreshTokens    RefreshToken[]
  bookings         Booking[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model VerificationCode {
  id          String   @id @default(uuid())
  phoneNumber String
  code        String
  type        VerificationType @default(REGISTRATION)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([phoneNumber])
  @@map("verification_codes")
}

model Restaurant {
  id              String    @id @default(uuid())
  name            String
  description     String?
  address         String
  phoneNumber     String
  email           String?
  website         String?
  cuisine         CuisineType[]
  priceRange      PriceRange @default(MODERATE)
  rating          Float?    @default(0)
  capacity        Int
  imageUrls       String[]  @default([])
  openingHours    Json      // Format: {"monday": {"open": "09:00", "close": "22:00"}, ...}
  features        RestaurantFeature[] @default([])
  isActive        Boolean   @default(true)
  bookings        Booking[]
  bills           Bill[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([cuisine])
  @@index([priceRange])
  @@index([rating])
  @@index([features])
  @@index([isActive])
  @@map("restaurants")
}

model Booking {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId  String
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  bookingDate   DateTime
  bookingTime   String        // Format: "19:00"
  guestCount    Int
  specialRequests String?
  status        BookingStatus @default(PENDING)
  customerName  String
  customerPhone String
  customerEmail String?
  notes         String?       // Internal notes for restaurant
  bills         Bill[]        // Связанные счета
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([restaurantId])
  @@index([bookingDate])
  @@index([status])
  @@map("bookings")
}

model Bill {
  id            String        @id @default(uuid())
  billNumber    String        @unique     // Уникальный номер счета (например, BILL-2024-001)
  bookingId     String?                   // Связь с бронированием (может быть null для walk-in клиентов)
  booking       Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  restaurantId  String                    // Ресторан, который выставил счет
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  // Информация о клиенте
  customerName  String
  customerPhone String?
  customerEmail String?
  
  // Детали счета
  items         Json          // Массив блюд: [{ name: "Хинкали", quantity: 10, price: 500, total: 5000 }]
  itemsText     String        // Текстовое описание всех блюд для чтения
  
  // Финансовые данные
  subtotal      Decimal       // Сумма без скидок и налогов
  discountAmount Decimal      @default(0) // Размер скидки
  discountPercent Float?      // Процент скидки
  taxAmount     Decimal       @default(0) // Налог
  taxPercent    Float?        // Процент налога
  serviceCharge Decimal       @default(0) // Плата за обслуживание
  totalAmount   Decimal       // Итоговая сумма к оплате
  
  // Статус и оплата
  status        BillStatus    @default(PENDING)
  paymentMethod PaymentMethod?
  paidAt        DateTime?     // Время оплаты
  
  // Дополнительная информация
  notes         String?       // Заметки к счету
  receiptUrl    String?       // URL чека/квитанции
  
  // API интеграция
  externalId    String?       // ID из внешней системы ресторана
  externalData  Json?         // Дополнительные данные из API ресторана
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([billNumber])
  @@index([bookingId])
  @@index([restaurantId])
  @@index([status])
  @@index([createdAt])
  @@index([externalId])
  @@map("bills")
}

enum VerificationType {
  REGISTRATION
  PASSWORD_RESET
}

enum Role {
  USER
  ADMIN
  RESTAURANT_OWNER
}

enum PriceRange {
  BUDGET        // $
  MODERATE      // $$
  EXPENSIVE     // $$$
  LUXURY        // $$$$
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum BillStatus {
  PENDING      // Счет создан, ожидает оплаты
  PAID         // Счет оплачен
  CANCELLED    // Счет отменен
  REFUNDED     // Счет возвращен
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_PAYMENT
  CRYPTOCURRENCY
}

